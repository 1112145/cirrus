{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cirrus-api",
  "main": "src/index.ts",
  // keep <= the date supported by workerd in @cloudflare/vitest-plugin, or tests won't start
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "PROJECT_NAME": "Cirrus",
    "DEFAULT_LANGUAGE": "en-US"
  },

  // database_id: replace with the real ID after running `wrangler d1 create cirrus`
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cirrus",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]

  // Added in later milestones:
  // M1: kv_namespaces SCHEMA_CACHE (schema snapshot)
  // M5: r2_buckets STORAGE
  // M7: queues FLOWS, durable_objects REALTIME
}
