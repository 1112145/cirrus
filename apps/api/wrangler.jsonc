{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cirrus-api",
  "main": "src/index.ts",
  // keep <= the date supported by workerd in @cloudflare/vitest-plugin, or tests won't start
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "PROJECT_NAME": "Cirrus",
    "DEFAULT_LANGUAGE": "en-US",
    // Items per request when none is asked for, and the most a request may ask for (-1 = no maximum).
    // Keep the maximum modest: every row is serialized within the Worker's CPU and memory limits.
    "QUERY_LIMIT_DEFAULT": "100",
    "QUERY_LIMIT_MAX": "1000",
    // Most segments a path into relations may have (`author.team.name` is 3), as Directus' MAX_RELATIONAL_DEPTH.
    // Each relational field is one more statement in the request's batch.
    "MAX_RELATIONAL_DEPTH": "10",
    // Auth (spec §10), with Directus' names: access token and refresh token lifetimes, and the refresh token cookie.
    "ACCESS_TOKEN_TTL": "15m",
    "REFRESH_TOKEN_TTL": "7d",
    "REFRESH_TOKEN_COOKIE_SECURE": "true",
    "REFRESH_TOKEN_COOKIE_SAME_SITE": "lax",
    // `session` mode logins (the admin app): the access token in an httpOnly cookie, for this long.
    "SESSION_COOKIE_TTL": "1d",
    "SESSION_COOKIE_SECURE": "true",
    "SESSION_COOKIE_SAME_SITE": "lax",
    // Files (spec §11), with Directus' names: the MIME types uploads may have. FILES_MAX_UPLOAD_SIZE
    // (e.g. "100mb") caps each upload; unset, the plan's request size limit does.
    "FILES_MIME_TYPE_ALLOW_LIST": "*/*",
    // How long clients may cache assets.
    "ASSETS_CACHE_TTL": "30d",
    // Image transformations (IMAGES binding): most operations in `transforms`, largest source image side.
    "ASSETS_TRANSFORM_MAX_OPERATIONS": "5",
    "ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION": "6000"
  },

  // database_id: replace with the real ID after running `wrangler d1 create cirrus`
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cirrus",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Files' contents (spec §11): create it with `wrangler r2 bucket create cirrus-files`.
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "cirrus-files" }],

  // Cloudflare Images, for asset transformations (`/assets/:id?width=…`). Remove it to turn them off.
  "images": { "binding": "IMAGES" },

  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "base_path": "/admin",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/admin/*"]
  }

  // Secrets (`wrangler secret put <name>`; locally in .dev.vars):
  // SECRET: signs access tokens; without it nobody can log in
  // ADMIN_TOKEN: optional static admin token, to create the first users (and as a way back in)

  // Added in later milestones:
  // M7: queues FLOWS, durable_objects REALTIME
}
